<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dynamic third-party HTTP radio streams are needed for compatibility.
         First-party API endpoints and image fallbacks remain TLS-only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">ipapi.co</domain>
        <domain includeSubdomains="false">ipwho.is</domain>
        <domain includeSubdomains="false">api.iheart.com</domain>
        <domain includeSubdomains="false">raw.githubusercontent.com</domain>
        <domain includeSubdomains="false">api.somafm.com</domain>
        <domain includeSubdomains="false">itunes.apple.com</domain>
        <domain includeSubdomains="false">fmstream.org</domain>
        <domain includeSubdomains="false">de1.api.radio-browser.info</domain>
        <domain includeSubdomains="false">fi1.api.radio-browser.info</domain>
        <domain includeSubdomains="false">at1.api.radio-browser.info</domain>
        <domain includeSubdomains="false">www.google.com</domain>
        <domain includeSubdomains="false">wsrv.nl</domain>
    </domain-config>
</network-security-config>
